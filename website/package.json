{
  "name": "kubernanny-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.ts",
    "preview": "node scripts/serve.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "brand": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@analogjs/content": "^3.0.0",
    "@analogjs/router": "^3.0.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "h3": "^1.15.11",
    "mermaid": "^12.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/platform": "^3.0.0",
    "@analogjs/vite-plugin-angular": "^3.0.0",
    "@analogjs/vite-plugin-nitro": "^3.0.0",
    "@angular/build": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/node": "^22.20.5",
    "marked": "^18.3.0",
    "shiki": "^4.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "description": "The kubernanny.app website: landing page and the docs/ folder, prerendered to static HTML.",
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "vite": "$vite"
  }
}
