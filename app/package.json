{
  "name": "kubernanny-app",
  "version": "0.0.8",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:demo": "ng build --configuration production,demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "icons": "node scripts/generate-icons.mjs",
    "native-assets": "node scripts/native-assets.mjs",
    "build:ios": "ng build && cap sync ios",
    "build:android": "ng build && cap sync android",
    "release": "node scripts/release.mjs",
    "release:continue": "node scripts/release.mjs --continue",
    "release:production": "cd .. && bundle exec fastlane android release && bundle exec fastlane ios release",
    "store:metadata": "cd .. && bundle exec fastlane metadata",
    "store:screenshots": "cd .. && bundle exec fastlane screenshots",
    "store:shots": "../scripts/store-screenshots/run.sh",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.4",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@ionic/angular": "^8.8.21",
    "@jsverse/transloco": "^8.4.0",
    "@kubernanny/protocol": "file:../protocol",
    "@kubernanny/push-native": "file:native/push",
    "@kubernanny/widget-bridge": "file:native/widget-bridge",
    "ionicons": "^8.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Kubernanny app: the state of your Kubernetes clusters at a glance. iOS, Android and web.",
  "license": "Apache-2.0"
}
