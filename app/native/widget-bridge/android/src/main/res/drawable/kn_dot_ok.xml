<?xml version="1.0" encoding="utf-8"?>
<!-- A light as a dot with a soft ring, for list rows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><stroke android:width="2dp" android:color="#7336D6A8" /><size android:width="16dp" android:height="16dp" /></shape></item>
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/kn_ok" /></shape></item>
</layer-list>
