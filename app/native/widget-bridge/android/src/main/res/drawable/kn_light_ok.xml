<?xml version="1.0" encoding="utf-8"?>
<!-- The nanny's eye from branding/: a lit pupil inside a soft ring of the same colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/kn_ok" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/kn_surface" />
        </shape>
    </item>
    <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/kn_ok" />
        </shape>
    </item>
</layer-list>
