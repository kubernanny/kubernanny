<?xml version="1.0" encoding="utf-8"?>
<!-- One cluster, large: eye and name, two count tiles, the worst problems, the time of the check. Plain RemoteViews (no plain <View>: RemoteViews refuse it; spacers are FrameLayouts); texts in sp so the system font size applies.
     Filled in by WidgetRender. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kn_widget_background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/kn_eye" android:layout_width="72dp" android:layout_height="34dp" android:importantForAccessibility="no" android:scaleType="fitStart" android:src="@drawable/kn_eye_off" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/kn_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kn_ink" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/kn_demo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/kn_widget_pill" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="@string/kn_widget_demo" android:textColor="@color/kn_accent" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/kn_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_ink" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/kn_tiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/kn_widget_tile" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/kn_tile_crit" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kn_ink" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/kn_tile_crit_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kn_ink_2" android:textSize="12sp" android:textStyle="bold" android:text="@string/kn_widget_outages_tile" />
        </LinearLayout>
        <FrameLayout android:layout_width="10dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/kn_widget_tile" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/kn_tile_warn" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kn_ink" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/kn_tile_warn_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kn_ink_2" android:textSize="12sp" android:textStyle="bold" android:text="@string/kn_widget_warnings_tile" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/kn_prob_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/kn_prob_dot_0" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginTop="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_crit" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/kn_prob_title_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_ink" android:textSize="13sp" />
            
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/kn_prob_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/kn_prob_dot_1" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginTop="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_crit" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/kn_prob_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_ink" android:textSize="13sp" />
            
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/kn_prob_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/kn_prob_dot_2" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginTop="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_crit" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/kn_prob_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_ink" android:textSize="13sp" />
            
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/kn_prob_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/kn_prob_dot_3" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginTop="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_crit" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/kn_prob_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_ink" android:textSize="13sp" />
            
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/kn_no_problems" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_ink_2" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" android:drawableStart="@drawable/kn_dot_ok" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="@string/kn_widget_no_problems" android:visibility="gone" />
    <TextView android:id="@+id/kn_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="4" android:textColor="@color/kn_ink_2" android:textSize="14sp" android:layout_marginTop="8dp" android:text="@string/kn_widget_empty" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/kn_time_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/kn_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_mute" android:textSize="11sp" android:textStyle="bold" />
        <ImageView android:id="@+id/kn_refresh" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="-7dp" android:layout_marginBottom="-7dp" android:layout_marginEnd="-7dp" android:padding="7dp" android:contentDescription="@string/kn_widget_refresh" android:src="@drawable/kn_refresh" />
    </LinearLayout>
</LinearLayout>
