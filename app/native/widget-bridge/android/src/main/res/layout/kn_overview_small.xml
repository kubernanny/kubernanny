<?xml version="1.0" encoding="utf-8"?>
<!-- All clusters, small: the worst light, everything added up, a dot per cluster. Plain RemoteViews (no plain <View>: RemoteViews refuse it; spacers are FrameLayouts); texts in sp so the system font size applies.
     Filled in by WidgetRender. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kn_widget_background"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/kn_eye" android:layout_width="56dp" android:layout_height="26dp" android:importantForAccessibility="no" android:scaleType="fitStart" android:src="@drawable/kn_eye_off" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/kn_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kn_mute" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/kn_headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="3" android:textColor="@color/kn_ink" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="10dp" />
    <TextView android:id="@+id/kn_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="4" android:textColor="@color/kn_ink_2" android:textSize="14sp" android:layout_marginTop="8dp" android:text="@string/kn_widget_empty" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/kn_dots" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/kn_sdot_0" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_4" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_5" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_6" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
        <ImageView android:id="@+id/kn_sdot_7" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/kn_dot_off" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/kn_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/kn_mute" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="5dp" />
</LinearLayout>
