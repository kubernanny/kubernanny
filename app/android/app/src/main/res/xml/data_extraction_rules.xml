<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or carried to a new phone: the app's storage holds this
  device's private key per cluster, which must never leave the device
  (docs/SECURITY.md). A new phone pairs again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
