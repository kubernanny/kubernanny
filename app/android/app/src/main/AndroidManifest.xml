<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backups are off (allowBackup, dataExtractionRules): the app keeps a private
         device key per cluster that must stay on this phone. Cleartext HTTP is
         allowed for agents in the LAN or a VPN because every call is end-to-end
         encrypted (res/xml/network_security_config.xml, docs/RELEASING.md).
         No uses-feature may be required: see docs/RELEASING.md before adding a plugin. -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pairing links from the agent's QR code: kubernanny://pair?url=…&code=…&key=…
                 (parsed by pairingRoute in src/app/core/pairing-link.ts). Any app or site can
                 open one, so the pairing page connects only after the person confirmed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kubernanny" android:host="pair" />
            </intent-filter>

        </activity>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
