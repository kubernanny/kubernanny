    "@hpke/core": "^1.10.1",
    "@hpke/dhkem-x25519": "^1.8.1",
    "@types/node": "^22.20.5",
    "noise-protocol": "^3.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
